+/* Task 05: readable feedback and existing recorded scores, without projection. */
+.feedback-workbench .feedback-content > .glass { padding: 22px; }
+.feedback-workbench h3 { font-size: 15px; line-height: 1.5; letter-spacing: -.015em; }
+.feedback-workbench p { overflow-wrap: anywhere; }
+.feedback-summary p { max-width: 68ch; }
+.feedback-original,.feedback-suggested { padding: 12px 14px; border-radius: 12px; margin-bottom: 10px; }
+.feedback-original { background: #ffffff03; border-left: 2px solid hsl(var(--muted-foreground) / .45); }
+.feedback-suggested { background: hsl(var(--primary) / .07); border-left: 2px solid hsl(var(--primary) / .65); }
+.feedback-original>span,.feedback-suggested>span { display: block; font-size: 10px; letter-spacing: .09em; margin-bottom: 6px; color: var(--spatial-text-secondary); text-transform: uppercase; }
+.feedback-original p,.feedback-suggested p { font-size: 14px; line-height: 1.75; color: hsl(var(--foreground)); }
+.report-total,.report-score-number,.history-record .text-lg { font-variant-numeric: tabular-nums; }
+.report-score-row { display: grid; grid-template-columns: minmax(0,1fr) minmax(70px,1fr) max-content; gap: 12px; align-items: center; }
+.report-score-label { min-width: 0; overflow-wrap: anywhere; }
+.report-score-meter { width: auto; min-width: 0; }
+.report-score-number { min-width: 48px; text-align: right; font-variant-numeric: tabular-nums; }
+.skill-chart-notice { font-size: 12px; line-height: 1.7; padding: 0 16px 12px; color: var(--spatial-text-secondary); text-align: center; }
+.skill-dimensions button { min-height: 44px; overflow-wrap: anywhere; max-width: 100%; }
+.skill-radar .recharts-tooltip-wrapper { z-index: 3; max-width: min(250px,90vw); }
+.history-record { scroll-margin-top: 24px; }
+.history-record-title { overflow-wrap: anywhere; line-height: 1.5; }
+.history-record>button { align-items: flex-start; min-height: 76px; }
+.history-record p,.history-page h1 { overflow-wrap: anywhere; }
+.history-retry { min-height: 44px; margin-top: 10px; padding: 8px 14px; border-radius: 10px; background: hsl(var(--primary) / .1); color: #dacaf6; }
+.history-page .text-\[10px\] { font-size: 12px; line-height: 1.6; }
+.history-page .text-\[9px\] { font-size: 11px; }
+.feedback-actions { gap: 10px; }
+.feedback-actions button { white-space: normal; line-height: 1.4; }
+@media(max-width:480px) {
+  .feedback-workbench .feedback-content > .glass { padding: 16px; }
+  .report-score-row { grid-template-columns: minmax(0,1fr) max-content; gap: 6px 12px; }
+  .report-score-meter { grid-column: 1/-1; grid-row: 2; }
+  .report-score-number { grid-column: 2; grid-row: 1; }
+  .feedback-actions button { flex: 1 1 110px; }
+}
+.history-page .text-muted-foreground\/60,.feedback-workbench .text-muted-foreground\/60 { color: var(--spatial-text-secondary); }
+@media(max-width:480px) { .history-page>div:first-child { flex-wrap: wrap; row-gap: 8px; } }
