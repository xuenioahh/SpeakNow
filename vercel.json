{
  "fluid": true,
  "builds": [
    { "src": "package.json", "use": "@vercel/static-build", "config": { "distDir": "dist" } },
    { "src": "server/api.js", "use": "@vercel/node", "config": { "maxDuration": 120 } }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/server/api.js?__speaknow_route=$1" },
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
