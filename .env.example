OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_VOICE_CHAT_MODEL=openrouter/free
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_CONVERSATION_MODEL=deepseek-flash
DEEPSEEK_FEEDBACK_MODEL=deepseek-v4-pro
# IELTS pronunciation assessment (server only; local recording checks need no key)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
SPEAKNOW_SPEECH_DAILY_REQUESTS=100
SPEAKNOW_SPEECH_GLOBAL_REQUESTS=1000
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
SPEAKNOW_DYNAMIC_TTS=browser
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4.7-flash
LONGCAT_API_KEY=
LONGCAT_MODEL=LongCat-Flash-Lite
VOLCENGINE_ARK_API_KEY=
VOLCENGINE_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_ARK_MODEL=

# Cloud storage: choose mongodb for MongoDB Atlas, or supabase for an existing deployment.
# Never prefix these server credentials with VITE_.
SPEAKNOW_STORAGE_PROVIDER=
MONGODB_URI=
MONGODB_DB=speaknow

# Existing Supabase configuration (unused when mongodb is selected)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Force app/admin data to stay in local JSON instead of Supabase.
FORCE_LOCAL_DATA=false

# Admin access requires a server session with an authorized admin role.
# x-user-id and x-admin-key are not credentials.

# Comma-separated emails that should see /admin in the frontend
VITE_ADMIN_EMAILS=admin1@example.com,admin2@example.com

# Optional explicit provider: auto | deepseek | openai | openrouter | zhipu | longcat | partner
# An explicit selection does not fall back to another billing account.
LLM_PROVIDER=auto
EXPRESSION_LLM_PROVIDER=
OPENAI_MODEL=gpt-5-mini
# ChatGPT subscription credits are not OpenAI Platform API credits.
OPENAI_BASE_URL=https://api.openai.com/v1
# Reserved server-side integration for a partner with a compatible Chat Completions API.
PARTNER_API_KEY=
PARTNER_BASE_URL=
PARTNER_MODEL=

# Unified Impact Studio (existing model retained)
SPEAKNOW_IMPACT_MODEL=gpt-4o-mini
# Exact public origin in production, e.g. https://your-domain.example
SPEAKNOW_ORIGIN=
# Persistent local data folder (development only; production normally uses Supabase)
SPEAKNOW_DATA_DIR=
SPEAKNOW_AI_DAILY_REQUESTS=100
SPEAKNOW_TRIAL_MINUTE_REQUESTS=20
SPEAKNOW_AI_MINUTE_REQUESTS=24
SPEAKNOW_AI_GLOBAL_REQUESTS=2000
# Conservative reservation of 100000 tokens per AI request, provider retries included.
SPEAKNOW_AI_DAILY_TOKEN_BUDGET=600000
SPEAKNOW_AI_GLOBAL_TOKEN_BUDGET=2000000

# Membership preview. Production remains in usage-tracking mode until payments exist.
SPEAKNOW_PAYWALL_ENABLED=false
SPEAKNOW_MEMBERSHIP_TEST_MODE=false
SPEAKNOW_FREE_MOCK_MONTHLY=4
SPEAKNOW_FREE_DRILL_MONTHLY=30
SPEAKNOW_FREE_DAILY_SECONDS=300
SPEAKNOW_FREE_AI_REQUESTS=100
# VIP allowances are finite. Online payments remain unavailable.
SPEAKNOW_VIP_TRIAL_ENABLED=true
SPEAKNOW_VIP_DAILY_SECONDS=10800
SPEAKNOW_VIP_AI_REQUESTS=600
# User-supplied sources remain private unless redistribution rights are verified.
SPEAKNOW_BANK_RIGHTS_VERIFIED=false
SPEAKNOW_PRIVATE_BANK_OWNER_IDS=
